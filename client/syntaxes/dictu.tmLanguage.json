{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Dictu",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#annotations"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#names"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#arguments"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.dictu",
					"match": "(//.*)"
				},
				{
					"name": "comment.block.dictu",
					"begin": "/\\*",
					"end": "\\*/"
				},
				{
					"name": "comment.line.shebang.dictu",
					"match": "^(#!.*)"
				}
			]
		},
		"annotations": {
			"patterns": [
				{
					"name": "meta.annotation.dictu",
					"match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "punctuation.definition.annotation.dictu"
						},
						"2": {
							"name": "entity.name.function.annotation.dictu"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.dictu",
					"match": "\\b(if|else|while|for|return|break|continue|with|switch|case|default)\\b"
				},
				{
					"name": "constant.language.dictu",
					"match": "\\b(true|false|nil)\\b"
				},
				{
					"name": "keyword.other.dictu",
					"match": "\\b(def|var|const|class|enum|trait|import|from|as|use)\\b"
				},
				{
					"name": "keyword.operator.logical.dictu",
					"match": "\\b(and|or|not)\\b"
				},
				{
					"name": "storage.modifier.dictu",
					"match": "\\b(abstract|static|private)\\b"
				},
				{
					"name": "support.function.builtin.dictu",
					"match": "\\b(print|printError|input|type|assert|isDefined|set)\\b(?=\\s*\\()"
				},
				{
					"name": "support.type.result.dictu",
					"match": "\\b(Success|Error)\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.raw.dictu",
					"begin": "r\"",
					"end": "\"",
					"patterns": []
				},
				{
					"name": "string.quoted.raw.dictu",
					"begin": "r'",
					"end": "'",
					"patterns": []
				},
				{
					"name": "string.quoted.double.dictu",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.dictu",
							"match": "\\\\(?:[\\\\\"'nrtv0]|x[0-9a-fA-F]{2})"
						},
						{
							"name": "constant.other.placeholder.dictu",
							"match": "\\{\\}"
						}
					]
				},
				{
					"name": "string.quoted.single.dictu",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.dictu",
							"match": "\\\\(?:[\\\\\"'nrtv0]|x[0-9a-fA-F]{2})"
						},
						{
							"name": "constant.other.placeholder.dictu",
							"match": "\\{\\}"
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.dictu",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.float.dictu",
					"match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
				},
				{
					"name": "constant.numeric.integer.dictu",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.dictu",
					"match": "=>"
				},
				{
					"name": "keyword.operator.spread.dictu",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.optional-chaining.dictu",
					"match": "\\?\\."
				},
				{
					"name": "keyword.operator.comparison.dictu",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.assignment.compound.dictu",
					"match": "\\+=|-=|\\*=|/=|&=|\\^=|\\|="
				},
				{
					"name": "keyword.operator.arithmetic.dictu",
					"match": "\\*\\*|[+\\-*/%]"
				},
				{
					"name": "keyword.operator.bitwise.dictu",
					"match": "[&^|]"
				},
				{
					"name": "keyword.operator.ternary.dictu",
					"match": "\\?"
				}
			]
		},
		"names": {
			"patterns": [
				{
					"comment": "class Name < Parent — inheritance with both class and parent highlighted as types",
					"match": "(?<=class\\s+)([A-Za-z_][A-Za-z0-9_]*)\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "entity.name.type.class.dictu"
						},
						"2": {
							"name": "keyword.operator.inheritance.dictu"
						},
						"3": {
							"name": "entity.name.type.class.dictu"
						}
					}
				},
				{
					"name": "entity.name.type.class.dictu",
					"match": "(?<=class\\s+)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "entity.name.type.class.dictu",
					"match": "(?<=trait\\s+)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "entity.name.type.class.dictu",
					"match": "(?<=enum\\s+)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "entity.name.function.definition.dictu",
					"match": "(?<=def\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
				},
				{
					"name": "entity.name.type.dictu",
					"match": "\\b([A-Z][A-Za-z0-9_]*)\\b"
				},
				{
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
					"captures": {
						"1": {
							"name": "entity.name.function.dictu"
						}
					}
				},
				{
					"name": "variable.language.this.dictu",
					"match": "\\b(this)\\b"
				},
				{
					"name": "variable.language.super.dictu",
					"match": "\\b(super)\\b"
				},
				{
					"name": "variable.other.property.dictu",
					"match": "(?<=\\.)[a-zA-Z_][a-zA-Z0-9_]*"
				},
				{
					"name": "variable.other.dictu",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
				}
			]
		},
		"arguments": {
			"patterns": [
				{
					"name": "variable.parameter.dictu",
					"match": "(?<=\\()\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*,\\s*([a-zA-Z_][a-zA-Z0-9_]*))*\\s*(?=\\))"
				}
			]
		}
	},
	"scopeName": "source.du"
}