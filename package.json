{
	"name": "dictuvsc",
	"description": "Dictu language server protocol",
	"author": "Jason Hall",
	"license": "MIT",
	"version": "2.0.0",
	"icon": "logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/dictu-lang/DictuVSC"
	},
	"publisher": "Dictu",
	"categories": [
		"Programming Languages",
		"Snippets",
		"Linters"
	],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"workspaceContains:**/*.du"
	],
	"main": "./dist/extension",
	"contributes": {
		"commands": [
			{
				"command": "dictu.runFile",
				"title": "Run Dictu File",
				"category": "Dictu",
				"icon": "$(play)"
			},
			{
				"command": "dictu.runSelection",
				"title": "Run Selection/Line in Dictu",
				"category": "Dictu"
			},
			{
				"command": "dictu.newFile",
				"title": "New Dictu File",
				"category": "Dictu",
				"icon": "$(file-add)"
			},
			{
				"command": "dictu.toggleBlockComment",
				"title": "Toggle Block Comment",
				"category": "Dictu"
			}
		],
		"keybindings": [
			{
				"command": "dictu.runFile",
				"key": "ctrl+shift+r",
				"mac": "cmd+shift+r",
				"when": "editorLangId == dictu"
			},
			{
				"command": "dictu.runSelection",
				"key": "ctrl+shift+enter",
				"mac": "cmd+shift+enter",
				"when": "editorLangId == dictu"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "dictu.runFile",
					"when": "resourceLangId == dictu",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "dictu.runFile",
					"when": "resourceLangId == dictu",
					"group": "1_run@1"
				},
				{
					"command": "dictu.runSelection",
					"when": "resourceLangId == dictu && editorHasSelection",
					"group": "1_run@2"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "Dictu LSP",
			"properties": {
				"dictuLanguageServer.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"dictuLanguageServer.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"dictu.dictuPath": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "dictu",
					"description": "Path to the Dictu executable. Defaults to 'dictu' (must be on PATH)."
				},
				"dictu.formatOnSave": {
					"scope": "resource",
					"type": "boolean",
					"default": false,
					"description": "Automatically format Dictu files on save."
				},
				"dictu.indentSize": {
					"scope": "resource",
					"type": "number",
					"default": 4,
					"description": "Number of spaces per indentation level for the Dictu formatter."
				}
			}
		},
		"languages": [
			{
				"id": "dictu",
				"aliases": [
					"Dictu",
					"dictu"
				],
				"extensions": [
					".du",
					".dictu"
				],
				"configuration": "./client/language-configuration.json",
				"icon": {
					"light": "./logo.png",
					"dark": "./logo.png"
				}
			}
		],
		"grammars": [
			{
				"language": "dictu",
				"scopeName": "source.du",
				"path": "./client/syntaxes/dictu.tmLanguage.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "webpack --mode production",
		"webpack": "webpack --mode development",
		"webpack-dev": "webpack --mode development --watch",
		"test-compile": "tsc -p ./",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.0",
		"@types/node": "^20.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.0.0",
		"mocha": "^10.0.0",
		"ts-loader": "^9.5.0",
		"typescript": "^5.5.0",
		"webpack": "^5.95.0",
		"webpack-cli": "^5.1.0",
		"@vscode/vsce": "^3.0.0"
	}
}
